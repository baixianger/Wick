            "value": "添加持仓"
          }
        }
      }
    },
    "Add this to `~/.claude.json` (Claude Code) or your Codex `mcp.json` — then the agent can call `wick.snapshot`, `wick.candles`, `wick.holdings`, `wick.watchlist`, `wick.portfolio`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将以下内容添加到 `~/.claude.json`（Claude Code）或你的 Codex `mcp.json`——之后智能体即可调用 `wick.snapshot`、`wick.candles`、`wick.holdings`、`wick.watchlist`、`wick.portfolio`。"
          }
        }
      }
    },
